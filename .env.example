# このファイルは見本です（Gitに入ります）。本物の値は .env.local に書いてください（Gitに入りません）。
# 書き換えたら、開発用サーバーを再起動してください。

# Claude API のキー（Claude Console で作成）。サーバー側だけで使い、ブラウザには送りません。
ANTHROPIC_API_KEY=

# 1 にすると、AI処理を料金のかからないサンプルに切り替えます（画面の確認用）。
# NEXT_PUBLIC_USE_MOCK_AI=1

# 合言葉（知人と共有する）。前後の空白は無視されます。変えると全員がもう一度入力することになります。
ACCESS_PASSPHRASE=

# 通過済みの印に署名するための長いランダムな文字列（32文字以上）。自分のターミナルで次を実行して作れます：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
